{
  "appId": "dev.marmot.editor",
  "productName": "Marmot",
  "copyright": "Copyright 2026 Marmot contributors",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "assets/marmot.icns",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/main.js"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "assets/marmot.icns",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Marmot ${version}",
    "icon": "assets/marmot.icns"
  },
  "win": {
    "icon": "assets/marmot.icns",
    "target": ["nsis"]
  },
  "linux": {
    "icon": "assets/marmot.icns",
    "category": "Office",
    "target": ["AppImage"]
  }
}
